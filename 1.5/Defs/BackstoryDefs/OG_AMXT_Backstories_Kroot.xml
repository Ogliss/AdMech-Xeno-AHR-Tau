  <AlienRace.AlienBackstoryDef Name="Kroot_Base_Child">
    <defName>OG_Kroot_Base_Child</defName>
    <title>Krootling</title>
    <titleShort>krootspawn</titleShort>
    <baseDesc>[PAWN_nameDef] was born as a member of a carnivore kindred. A Carnivore Kindred is a type of Kroot kindred and represents the core of any Kroot mercenary band, this kindred is a flexible fighting team with no specific adaptations, though their Shaper is always on the look-out for fresh foes whose genetic traits can be absorbed. As such, the path of the warrior was [PAWN_possessive] destiny.</baseDesc>
    <bodyTypeGlobal>Thin</bodyTypeGlobal>
	<bodyTypeMale>Thin</bodyTypeMale>
    <bodyTypeFemale>Thin</bodyTypeFemale>
    <slot>Childhood</slot>
	<disallowedTraits>
		<PsychicSensitivity>2</PsychicSensitivity>
		<!-- The Force -->
		<PJ_ForceSensitive MayRequire="PJedi.starwars.Force">0</PJ_ForceSensitive>
		<PJ_JediTrait MayRequire="PJedi.starwars.Force">0</PJ_JediTrait>
		<PJ_SithTrait MayRequire="PJedi.starwars.Force">0</PJ_SithTrait>
		<PJ_GrayTrait MayRequire="PJedi.starwars.Force">0</PJ_GrayTrait>
		<!-- The Force: Continued -->
		<PJ_ForceSensitive MayRequire="Mlie.StarWarsTheForce">0</PJ_ForceSensitive>
		<PJ_JediTrait MayRequire="Mlie.StarWarsTheForce">0</PJ_JediTrait>
		<PJ_SithTrait MayRequire="Mlie.StarWarsTheForce">0</PJ_SithTrait>
		<PJ_GrayTrait MayRequire="Mlie.StarWarsTheForce">0</PJ_GrayTrait>
		<!-- RimWolrd of Magic -->
		<TM_Gifted MayRequire="Torann.ARimworldOfMagic">0</TM_Gifted>
		<InnerFire MayRequire="Torann.ARimworldOfMagic">0</InnerFire>
		<HeartOfFrost MayRequire="Torann.ARimworldOfMagic">0</HeartOfFrost>
		<StormBorn MayRequire="Torann.ARimworldOfMagic">0</StormBorn>
		<Arcanist MayRequire="Torann.ARimworldOfMagic">0</Arcanist>
