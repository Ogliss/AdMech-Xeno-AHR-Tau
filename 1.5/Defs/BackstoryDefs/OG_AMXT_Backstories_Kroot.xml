 <AlienRace.BackstoryDef>
    <defName>Kroot_Child_Hunter</defName>
    <title>Hunter Child</title>
    <titleShort>Hunter</titleShort>
    <slot>Childhood</slot>
    <spawnCategories>
        <li>KrootChild</li>
    </spawnCategories>
    <forcedTraits>
        <Industrious>0</Industrious>
    </forcedTraits>
    <disallowedTraits>
        <Lazy>0</Lazy>
    </disallowedTraits>
    <forcedTraitsChance>
        <li>
            <defName Degree="1">Brawler</defName>
            <chance>0.15</chance>
        </li>
        <li>
            <defName Degree="1">Nimble</defName>
            <chance>0.1</chance>
        </li>
    </forcedTraitsChance>
    <skillGains>
        <Shooting>2</Shooting>
        <Animals>1</Animals>
    </skillGains>
    <baseDesc>[PAWN_nameDef] grew up in a hunter-gatherer Kindred, learning to track and hunt from a young age. [PAWN_pronoun] quickly became known for [PAWN_possessive] industrious nature and skill with a bow. The elders often remarked on how [PAWN_pronoun] never seemed to tire, always ready to pursue the next hunt. Tales were told of [PAWN_possessive] encounters with agile predators, honing [PAWN_possessive] reflexes and strength.</baseDesc>
</AlienRace.BackstoryDef>

<AlienRace.BackstoryDef>
    <defName>Kroot_Child_Scavenger</defName>
