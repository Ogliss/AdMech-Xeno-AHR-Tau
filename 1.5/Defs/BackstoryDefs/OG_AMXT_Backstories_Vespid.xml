<!-- Baseline Child -->
  <AlienRace.AlienBackstoryDef Name="Vespid_Base_Child">
    <defName>OG_Vespid_Base_Child</defName>
    <title>Vespidling</title>
    <titleShort>krootspawn</titleShort>
    <baseDesc>[PAWN_nameDef] was born as a member of a Vespid hive. A Vespid hive is a type of Vespid kindred and represents the core of any Vespid mercenary band, this kindred is a flexible fighting team with no specific adaptations, though their Shaper is always on the look-out for fresh foes whose genetic traits can be absorbed. As such, the path of the warrior was [PAWN_possessive] destiny.</baseDesc>
    <bodyTypeGlobal>Thin</bodyTypeGlobal>
	<bodyTypeMale>Thin</bodyTypeMale>
    <bodyTypeFemale>Thin</bodyTypeFemale>
    <slot>Childhood</slot>
	<disallowedTraits>
		<PsychicSensitivity>2</PsychicSensitivity>
    </disallowedTraits>
    <workDisables>
    </workDisables>
    <skillGains>
        <Shooting>4</Shooting>
        <Melee>4</Melee>
        <Plants>2</Plants>
        <Social>-6</Social>
    </skillGains>
    <spawnCategories>
      <li>Vespid_Standard</li>
      <li>Vespid_Strainleader</li>
      <li>Vespid_Warrior</li>
      <li>Vespid_Young</li>
    </spawnCategories>
  </AlienRace.AlienBackstoryDef>
 
